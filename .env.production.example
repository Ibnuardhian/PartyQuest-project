# Copy to .env.production on the server and fill in. Never commit .env.production.
# Domain pointing to the VPS IP (A record). Caddy gets the HTTPS certificate for it.
DOMAIN=partyquest.example.com

POSTGRES_DB=partyquest
POSTGRES_USER=partyquest
# Long random value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# At least 32 random characters, for example: openssl rand -hex 32
GUEST_SESSION_SECRET=change-me

# Narrator: elevenlabs (default, committed Adam pack, no key needed to play) or microsoft.
TTS_PROVIDER=elevenlabs
TTS_VOICE=id-ID-ArdiNeural
# Optional; only needed to generate new ElevenLabs lines on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Set to 1 to enable the voice pilot TTS route in production.
WEREWOLF_VOICE_PILOT=
