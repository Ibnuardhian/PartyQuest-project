# Online Room uses plain PostgreSQL. Pass-and-Play works without these values.
# Compose builds DATABASE_URL from the POSTGRES_* values below; set it directly for Vercel/production.
DATABASE_URL=
# Random string, at least 32 characters. Signs the HttpOnly guest cookie. Server-only.
GUEST_SESSION_SECRET=
# Optional: maximum connections per server process (default 10).
DATABASE_POOL_MAX=

# Werewolf voice moderator (Microsoft Edge Neural TTS). Optional.
# Voice: id-ID-GadisNeural (default) or id-ID-ArdiNeural.
TTS_VOICE=
# Directory for cached MP3 lines (default: the OS temp directory).
TTS_CACHE_DIR=
# Set to 1 to enable the voice pilot TTS route in production (always on in development).
WEREWOLF_VOICE_PILOT=

# Local development PostgreSQL. Port is bound to localhost for dev/port-forward access only.
POSTGRES_PORT=5432
POSTGRES_DB=partyquest
POSTGRES_USER=partyquest
POSTGRES_PASSWORD=partyquest_dev_only

# Host port for the dev web server.
WEB_PORT=3000
